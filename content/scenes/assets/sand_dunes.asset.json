{
  "id": "sand_dunes",
  "name": "Sand Dunes",
  "icon": "🏜️",
  "category": "environment",
  "tags": ["desert", "sand", "jalapao", "ground"],
  "desc": "Warm-toned wavy dune silhouettes layered along the horizon",
  "params": {
    "y":     { "type": "y",     "default": "bY" },
    "color1":{ "type": "color", "default": "#E8B06A" },
    "color2":{ "type": "color", "default": "#C48A4A" }
  },
  "code": "const ay = ctx.y ?? 260; const c1 = ctx.color1 || '#E8B06A'; const c2 = ctx.color2 || '#C48A4A';\nconst w_ = ctx.w || 800;\nsvg += `<path d=\"M0 ${ay+10} Q${w_*0.15} ${ay-14} ${w_*0.32} ${ay} Q${w_*0.5} ${ay-20} ${w_*0.68} ${ay-2} Q${w_*0.85} ${ay-16} ${w_} ${ay+2} L${w_} ${ay+40} L0 ${ay+40} Z\" fill=\"${c1}\" opacity=\"0.9\"/>`;\nsvg += `<path d=\"M0 ${ay+25} Q${w_*0.2} ${ay+8} ${w_*0.4} ${ay+22} Q${w_*0.6} ${ay+6} ${w_*0.8} ${ay+22} Q${w_*0.9} ${ay+14} ${w_} ${ay+26} L${w_} ${ay+50} L0 ${ay+50} Z\" fill=\"${c2}\" opacity=\"0.8\"/>`;"
}
