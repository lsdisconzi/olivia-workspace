  "desc": "A cheerful stone statue character, reminiscent of the Havan mascot, with a warm, weathered appearance, gentle smile, and a subtle golden glow.",
  "params": {
    "x": {
      "type": "x",
      "default": "w*0.5"
    },
    "y": {
      "type": "y",
      "default": "bY-30"
    },
    "scale": {
      "type": "number",
      "default": 1
    },
    "color": {
