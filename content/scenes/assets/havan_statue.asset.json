      "default": "#8B7D6B"
    },
    "happy": {
      "type": "boolean",
      "default": true
    }
  },
  "code": "function shade(hex, pct) {\n  hex = hex.replace('#','');\n  if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');\n  const num = parseInt(hex, 16);\n  const amt = Math.round(2.55 * pct);\n  let r = (num >> 16) + amt;\n  let g = ((num >> 8) & 0x00FF) + amt;\n  let b = (num & 0x0000FF) + amt;\n  r = Math.max(Math.min(255, r), 0);\n  g = Math.max(Math.min(255, g), 0);\n  b = Math.max(Math.min(255, b), 0);\n  return '#' + (0x1000000 + r * 0x10000 + g * 0x100 + b).toString(16).slice(1);\n}\n\nconst x = Number(ctx.x || 0);\nconst y = Number(ctx.y || 0);\nconst s = Number(ctx.scale || 1);\nconst col = ctx.color || '#8B7D6B';\nconst happy = ctx.happy !== false;\nconst ol = Math.max(1.5 * s, 1);\n\n// gentle idle bob + subtle glow (stone doesn't blink, but we can pulse a warm highlight)\nconst bob = Math.sin(mt * 1.8) * 1.5 * s;\nconst glow = 0.85 + Math.sin(mt * 2.5) * 0.1;\nconst bodyY = y + bob;\nconst gid = 'hstat_' + Math.round(x * 10) + '_' + Math.round(y * 10);\n\n// Gradients: stone texture with a warm highlight\nsvg += `<defs>\n  <linearGradient id=\"stone-${gid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n    <stop offset=\"0%\" stop-color=\"${shade(col, 18)}\"/>\n    <stop offset=\"40%\" stop-color=\"${col}\"/>\n    <stop offset=\"100%\" stop-color=\"${shade(col, -22)}\"/>\n  </linearGradient>\n  <radialGradient id=\"stone-glow-${gid}\" cx=\"50%\" cy=\"40%\" r=\"60%\">\n    <stop offset=\"0%\" stop-color=\"${shade(col, 35)}\" stop-opacity=\"0.3\"/>\n    <stop offset=\"100%\" stop-color=\"${shade(col, -10)}\" stop-opacity=\"0\"/>\n  </radialGradient>\n  <linearGradient id=\"base-${gid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n    <stop offset=\"0%\" stop-color=\"${shade(col, -5)}\"/>\n    <stop offset=\"100%\" stop-color=\"${shade(col, -30)}\"/>\n  </linearGradient>\n</defs>`;\n\n// ground shadow\nsvg += `<ellipse cx=\"${x}\" cy=\"${bodyY + 80*s}\" rx=\"${60*s}\" ry=\"${12*s}\" fill=\"rgba(0,0,0,0.2)\"/>`;\n\n// ---- the statue itself (converted from the original SVG paths) ----\n// The original SVG is huge; we keep the exact path data but wrap it in the new\n// transformation and styling, using the stone gradient and the new parameters.\n\n// We'll reuse the inner group id=\"g2148\" and all its paths, but we replace\n// the outer group transform with our own translation + scaling.\n// Also, we use the `col` variable for stroke and the stone gradient for fill,\n// and we add a subtle glow radial gradient behind the figure.\n\nsvg += `<g transform=\"translate(${x},${bodyY}) scale(${s})\">`;\n\n// Add a subtle glow behind the statue\nsvg += `<ellipse cx=\"0\" cy=\"0\" rx=\"${65*s}\" ry=\"${85*s}\" fill=\"url(#stone-glow-${gid})\" opacity=\"${glow}\"/>`;\n\n// The main statue group: we keep the original transform (translate(-8.7075743,168.21451))\n// because the paths are defined in that coordinate space; we just apply it as-is,\n// but we override stroke and fill with our parameters.\n// Since the original uses a global scale of 3.7795, we adjust our scale accordingly.\n// Original SVG width/height were ~112x145, so we scale to match the desired size.\n// We'll use a combined scale factor.\nconst statueScale = 0.18 * s; // tuned to fit the Fiat character scale\nsvg += `<g transform=\"translate(-8.7075743,168.21451) scale(${statueScale})\" stroke=\"${shade(col,-20)}\" stroke-width=\"${0.8 / statueScale}\" fill=\"url(#stone-${gid})\">`;\n\n// --- All paths from the original asset (copied verbatim) ---\nsvg += `<path d=\"m -2676.4183,1685.792 -10.0541,-0.2789 -0.7586,-0.3437 -0.7586,-0.3438 -0.4061,-1.2303 -0.406,-1.2304 -1.4496,-0.2449 -1.4496,-0.2449 -0.8591,-0.8591 -0.8592,-0.8591 0.2599,-0.9524 c 0.143,-0.5238 0.3651,-1.508 0.4935,-2.1871 l 0.2336,-1.2347 -0.4851,-1.1961 -0.4852,-1.1962 0.2315,-2.508 0.2314,-2.5081 -1.7053,-0.7967 c -0.9379,-0.4383 -1.8791,-0.7954 -2.0916,-0.7938 -0.2125,0 -0.671,-0.3116 -1.019,-0.6961 l -0.6326,-0.6991 0.2113,-1.5057 c 0.1162,-0.8282 0.3122,-1.9988 0.4355,-2.6013 l 0.2242,